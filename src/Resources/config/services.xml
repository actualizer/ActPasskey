<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Actualize\Passkey\Entity\PasskeyCredential\PasskeyCredentialDefinition">
            <tag name="shopware.entity.definition" entity="act_passkey_credential"/>
        </service>

        <service id="Actualize\Passkey\Entity\PasskeyUserHandle\PasskeyUserHandleDefinition">
            <tag name="shopware.entity.definition" entity="act_passkey_user_handle"/>
        </service>

        <service id="Actualize\Passkey\WebAuthn\Credential\UserHandleProvider" public="true">
            <argument type="service" id="act_passkey_user_handle.repository"/>
        </service>

        <!-- Realm-scoped, IDOR-safe credential lookup/save/delete. deleteOwned's
             combined id + realm + owner WHERE is the IDOR defense — never weaken it. -->
        <service id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository" public="true">
            <argument type="service" id="act_passkey_credential.repository"/>
        </service>

        <!-- Clock service id resolved via `debug:container clock`: `Psr\Clock\ClockInterface`
             and `Symfony\Component\Clock\ClockInterface` are both private aliases for the
             `clock` service (Symfony\Component\Clock\Clock). Referencing a private alias as
             a constructor argument works fine — privacy only blocks direct container->get(). -->
        <!-- Backed by `cache.app` (not the session) so challenges survive on the
             stateless admin /api endpoint — see ChallengeStore class doc. -->
        <service id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore" public="true">
            <argument type="service" id="cache.app"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <!-- Second argument (broaden-parent) is intentionally `null` for Phase 1: no
             configured RP-ID broadening yet. The bare `<argument>null</argument>` (no
             type attribute) goes through XmlFileLoader's default branch, which calls
             XmlUtils::phpize() on the node text; phpize() maps the literal string
             "null" to a real PHP null, not the string "null". Verified via
             `debug:container` (see task report) that the service instantiates. -->
        <service id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver" public="true">
            <argument type="string">%env(APP_URL)%</argument>
            <argument>null</argument>
        </service>

        <!-- Origins are derived ONLY from %APP_URL% + sales_channel_domain.url,
             NEVER from the request Host header (see OriginAllowlistProvider
             class doc for the security rationale). -->
        <service id="Actualize\Passkey\WebAuthn\RelyingParty\OriginAllowlistProvider" public="true">
            <argument type="string">%APP_URL%</argument>
            <argument type="service" id="sales_channel_domain.repository"/>
        </service>

        <!-- Builds the webauthn-lib CeremonyStepManagers with the pinned origin
             allowlist; algorithm/attestation-support managers stay at the
             library's own defaults (ES256/RS256, none-attestation). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\OriginAllowlistProvider"/>
        </service>

        <!-- Builds the webauthn-lib serializer once (none-attestation only). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer" public="true"/>

        <!-- Registration ("attestation") ceremony: builds creation options and
             verifies the browser attestation via the real webauthn-lib validator. -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\RegistrationCeremony" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\UserHandleProvider"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer"/>
        </service>

        <!-- Authentication ("assertion") ceremony: usernameless request options,
             realm-scoped credential lookup, account id resolved from the stored
             row (never from the assertion userHandle). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer"/>
        </service>

        <!-- Public login-challenge endpoint (auth_required=false). Plain public
             service: the controller does not extend AbstractController, so no
             setContainer call is needed. -->
        <service id="Actualize\Passkey\Controller\Admin\PasskeyAdminChallengeController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
        </service>

        <service id="Actualize\Passkey\OAuth\PasskeyGrant">
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
        </service>

        <!-- Enables the `passkey` grant on the shared, per-request AuthorizationServer.
             Mirrors core's ApiAuthenticationListener::setupOAuth() (KernelEvents::REQUEST,
             priority 128). Public so it can be resolved directly in integration tests. -->
        <service id="Actualize\Passkey\OAuth\PasskeyGrantSubscriber" public="true">
            <argument type="service" id="shopware.api.authorization_server"/>
            <argument type="service" id="Actualize\Passkey\OAuth\PasskeyGrant"/>
            <argument type="string">%shopware.api.access_token_ttl%</argument>
            <argument type="string">%shopware.api.refresh_token_ttl%</argument>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
