<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Actualize\Passkey\Entity\PasskeyCredential\PasskeyCredentialDefinition">
            <tag name="shopware.entity.definition" entity="act_passkey_credential"/>
        </service>

        <service id="Actualize\Passkey\Entity\PasskeyUserHandle\PasskeyUserHandleDefinition">
            <tag name="shopware.entity.definition" entity="act_passkey_user_handle"/>
        </service>

        <service id="Actualize\Passkey\WebAuthn\Credential\UserHandleProvider" public="true">
            <argument type="service" id="act_passkey_user_handle.repository"/>
        </service>

        <!-- Realm-scoped, IDOR-safe credential lookup/save/delete. deleteOwned's
             combined id + realm + owner WHERE is the IDOR defense — never weaken it. -->
        <service id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository" public="true">
            <argument type="service" id="act_passkey_credential.repository"/>
        </service>

        <!-- Own pool, not the session (challenges must survive on the stateless
             /api endpoint) and not cache.app (mapped to the array adapter in dev,
             which lives for one request — every passkey flow needs two). -->
        <service id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore" public="true">
            <argument type="service" id="act_passkey.challenge_pool"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <argument type="service" id="lock.factory"/>
        </service>

        <!-- Relying party id: APP_URL host, optionally broadened to a configured
             parent for the customer realm. -->
        <service id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver" public="true">
            <argument type="string">%env(APP_URL)%</argument>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\SalesChannelDomainProvider"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <!-- Single source for legitimate sales channel domains: active channels of
             type Storefront only. -->
        <service id="Actualize\Passkey\WebAuthn\RelyingParty\SalesChannelDomainProvider" public="true">
            <argument type="service" id="sales_channel_domain.repository"/>
        </service>

        <!-- Origins come ONLY from %APP_URL% plus, for customers, the active
             storefront domains — never from the request Host header. -->
        <service id="Actualize\Passkey\WebAuthn\RelyingParty\OriginAllowlistProvider" public="true">
            <argument type="string">%APP_URL%</argument>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\SalesChannelDomainProvider"/>
        </service>

        <!-- Builds the webauthn-lib CeremonyStepManagers with the pinned origin
             allowlist; algorithm/attestation-support managers stay at the
             library's own defaults (ES256/RS256, none-attestation). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\OriginAllowlistProvider"/>
        </service>

        <!-- Builds the webauthn-lib serializer once (none-attestation only). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer" public="true"/>

        <!-- Registration ("attestation") ceremony: builds creation options and
             verifies the browser attestation via the real webauthn-lib validator. -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\RegistrationCeremony" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\UserHandleProvider"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer"/>
        </service>

        <!-- Authentication ("assertion") ceremony: usernameless request options,
             realm-scoped credential lookup, account id resolved from the stored
             row (never from the assertion userHandle). -->
        <service id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\CeremonyFactory"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Challenge\ChallengeStore"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\WebauthnSerializer"/>
        </service>

        <!-- Public login-challenge endpoint (auth_required=false). Plain public
             service: the controller does not extend AbstractController, so no
             setContainer call is needed. -->
        <service id="Actualize\Passkey\Controller\Admin\PasskeyAdminChallengeController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
            <argument type="service" id="Shopware\Core\Framework\RateLimiter\RateLimiter"/>
        </service>

        <!-- Admin passkey self-service. Ownership comes from the token, mutations
             require the user-verified scope (fresh password confirmation). -->
        <service id="Actualize\Passkey\Controller\Admin\PasskeyAdminManageController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\RegistrationCeremony"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Shopware\Core\Framework\RateLimiter\RateLimiter"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Actualize\Passkey\Controller\Admin\PasskeyGovernanceController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Actualize\Passkey\WebAuthn\Customer\CustomerEligibilityGuard" public="true"/>

        <!-- Shared verify -> eligibility -> loginById. Both customer login entry points
             MUST go through this so the account checks cannot drift apart. -->
        <service id="Actualize\Passkey\WebAuthn\Customer\CustomerPasskeyLoginService" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Customer\CustomerEligibilityGuard"/>
            <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\AccountService"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
        </service>

        <!-- Store-api passkey login (challenge + login, both pre-login /
             auth_required=false): verifies a CUSTOMER-realm assertion and
             establishes the session via CustomerPasskeyLoginService. -->
        <service id="Actualize\Passkey\Controller\Store\PasskeyStoreApiController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Customer\CustomerPasskeyLoginService"/>
            <argument type="service" id="Shopware\Core\Framework\RateLimiter\RateLimiter"/>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Customer passkey self-service (list/register/rename/delete). Every route
             is `_loginRequired` + CustomerEntity (self-enforcing, guests rejected),
             re-runs the eligibility guard and demands a password step-up on the
             auth-factor-changing routes. -->
        <service id="Actualize\Passkey\Controller\Store\PasskeyManageStoreApiController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\RegistrationCeremony"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Customer\CustomerEligibilityGuard"/>
            <argument type="service" id="Shopware\Core\Framework\Validation\DataValidator"/>
            <argument type="service" id="Shopware\Core\Framework\RateLimiter\RateLimiter"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Storefront passkey login (challenge + login, both frontend-scope):
             shares CustomerPasskeyLoginService with PasskeyStoreApiController so
             the login page can fetch a challenge and post the assertion
             same-origin, then redirect into the account area. -->
        <service id="Actualize\Passkey\Controller\Storefront\PasskeyStorefrontController" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Customer\CustomerPasskeyLoginService"/>
            <argument type="service" id="Shopware\Core\Framework\RateLimiter\RateLimiter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Storefront passkey self-service (register/rename/delete on the
             customer's own account profile page): wraps
             PasskeyManageStoreApiController and calls it in-process, exactly
             like AccountProfileController does for its own store-api routes,
             so the eligibility guard, step-up password and rate limiting
             cannot drift from the store-api contract. -->
        <service id="Actualize\Passkey\Controller\Storefront\PasskeyManageStorefrontController" public="true">
            <argument type="service" id="Actualize\Passkey\Controller\Store\PasskeyManageStoreApiController"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Server-renders the customer's own passkey list into the account
             profile page (see class doc for why this bypasses the store-api
             JSON round-trip). -->
        <service id="Actualize\Passkey\Subscriber\Storefront\AccountProfilePasskeysSubscriber" public="true">
            <argument type="service" id="Actualize\Passkey\WebAuthn\Credential\CredentialRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Customer\CustomerEligibilityGuard"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Gates the login button on whether this domain resolves to a relying
             party id at all. -->
        <service id="Actualize\Passkey\Subscriber\Storefront\LoginPagePasskeySupportSubscriber">
            <argument type="service" id="Actualize\Passkey\WebAuthn\RelyingParty\RelyingPartyIdResolver"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Actualize\Passkey\Twig\AdministrationLoginScriptsExtension">
            <argument type="service" id="kernel"/>
            <tag name="twig.extension"/>
        </service>

        <service id="Actualize\Passkey\OAuth\PasskeyGrant">
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository"/>
            <argument type="service" id="Actualize\Passkey\WebAuthn\Ceremony\AuthenticationCeremony"/>
            <argument type="service" id="monolog.logger.act_passkey"/>
            <argument type="service" id="Actualize\Passkey\OAuth\AdminLoginPolicy"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Actualize\Passkey\OAuth\AdminLoginPolicy">
            <factory class="Actualize\Passkey\OAuth\AdminLoginPolicy" method="fromParameters"/>
            <argument type="service" id="parameter_bag"/>
        </service>

        <!-- Enables the `passkey` grant on the shared, per-request AuthorizationServer.
             Mirrors core's ApiAuthenticationListener::setupOAuth() (KernelEvents::REQUEST,
             priority 128). Public so it can be resolved directly in integration tests. -->
        <service id="Actualize\Passkey\OAuth\PasskeyGrantSubscriber" public="true">
            <argument type="service" id="shopware.api.authorization_server"/>
            <argument type="service" id="Actualize\Passkey\OAuth\PasskeyGrant"/>
            <argument type="string">%shopware.api.access_token_ttl%</argument>
            <argument type="string">%shopware.api.refresh_token_ttl%</argument>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
