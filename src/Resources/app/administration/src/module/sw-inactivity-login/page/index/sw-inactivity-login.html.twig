{#
    The core wraps this screen in a single block with no inner ones, so the
    passkey button cannot be appended after {% parent() %} — it would land
    outside the modal. The block is therefore replaced and the core markup below
    is a verbatim copy that has to be kept in sync when the core changes it.
#}
{% block sw_inactivity_login %}
<div class="sw-inactivity-login">

    <sw-modal
        v-if="lastKnownUser"
        class="sw-inactivity-login__modal"
        :title="$t('global.sw-inactivity-login.modal.title')"
        :closable="false"
    >
        <mt-password-field
            v-model="password"
            v-autofocus
            :label="$t('sw-login.index.labelPassword')"
            :disabled="isLoading"
            :error="passwordError"
            @keydown.enter="loginUserWithPassword"
        />

        <mt-checkbox
            v-model:checked="rememberMe"
            :label="$t('sw-login.index.labelKeepLoggedIn')"
        />

        {% block act_passkey_inactivity_login_submit %}
            <mt-button
                class="act-passkey-inactivity-login__button"
                variant="secondary"
                size="default"
                :block="true"
                :disabled="isLoading"
                @click.prevent="onPasskeyLogin"
            >
                {{ $t('sw-login.act-passkey.button') }}
            </mt-button>
        {% endblock %}

        <template #modal-footer>
            <a
                role="link"
                tabindex="0"
                @click="onBackToLogin"
                @keydown.enter="onBackToLogin"
            >
                {{ $t('global.sw-inactivity-login.modal.actions.backToLogin') }}
            </a>

            <mt-button
                variant="primary"
                :is-loading="isLoading"
                @click="loginUserWithPassword"
            >
                {{ $t('sw-login.index.buttonLogin') }}
            </mt-button>
        </template>
    </sw-modal>
</div>
{% endblock %}
