{# The core offers no inner block here, so this replaces the whole one: the
   markup below is a copy of the core's and has to be kept in sync with it. #}
{% block sw_inactivity_login %}
<div class="sw-inactivity-login">

    <sw-modal
        v-if="lastKnownUser"
        class="sw-inactivity-login__modal"
        :title="$t('global.sw-inactivity-login.modal.title')"
        :closable="false"
    >
        <mt-password-field
            v-model="password"
            v-autofocus
            :label="$t('sw-login.index.labelPassword')"
            :disabled="isLoading"
            :error="passwordError"
            @keydown.enter="loginUserWithPassword"
        />

        <mt-checkbox
            v-model:checked="rememberMe"
            :label="$t('sw-login.index.labelKeepLoggedIn')"
        />

        {# Inline margin: the modal body has no gap, and a plugin stylesheet is
           not loaded on this screen. #}
        {% block act_passkey_inactivity_login_submit %}
            <mt-button
                class="act-passkey-inactivity-login__button"
                style="margin-top: var(--scale-size-32);"
                variant="secondary"
                size="default"
                :block="true"
                :disabled="isLoading"
                @click.prevent="onPasskeyLogin"
            >
                {{ $t('sw-login.act-passkey.button') }}
            </mt-button>
        {% endblock %}

        <template #modal-footer>
            <a
                role="link"
                tabindex="0"
                @click="onBackToLogin"
                @keydown.enter="onBackToLogin"
            >
                {{ $t('global.sw-inactivity-login.modal.actions.backToLogin') }}
            </a>

            <mt-button
                variant="primary"
                :is-loading="isLoading"
                @click="loginUserWithPassword"
            >
                {{ $t('sw-login.index.buttonLogin') }}
            </mt-button>
        </template>
    </sw-modal>
</div>
{% endblock %}
