{# The inner block, not sw_login_login_submit: only in here is the button a child
   of the submit flex container and inherits its gap. #}
{% block sw_login_login_submit_button %}
    {% parent() %}

    {% block act_passkey_login_submit %}
        <mt-button
            class="act-passkey-login__button"
            variant="secondary"
            size="default"
            :block="true"
            @click.prevent="onPasskeyLogin"
        >
            {{ $t('sw-login.act-passkey.button') }}
        </mt-button>
    {% endblock %}
{% endblock %}
