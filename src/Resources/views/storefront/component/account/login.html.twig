{% sw_extends '@Storefront/storefront/component/account/login.html.twig' %}

{# The core offers no inner block here, so this replaces the whole one: the
   submit button below is a copy of the core's and has to be kept in sync. #}
{% block component_account_login_submit %}
    <div class="login-submit d-flex flex-wrap align-items-center gap-2">
        <button type="submit"
                class="btn btn-primary">
            {{ 'account.loginSubmit'|trans|sw_sanitize }}
        </button>

        {# Hidden until the JS plugin confirms WebAuthn support — hence the "or"
           sits in here too. #}
        <div class="act-passkey-login d-flex flex-wrap align-items-center gap-2"
             data-act-passkey-login
             data-challenge-url="{{ path('frontend.account.login.passkey.challenge') }}"
             data-login-url="{{ path('frontend.account.login.passkey') }}"
             data-error-text="{{ 'act-passkey.login.error'|trans }}"
             hidden>
            {% block act_passkey_login_divider %}
                <span class="act-passkey-login__divider text-muted small">
                    {{ 'act-passkey.login.divider'|trans }}
                </span>
            {% endblock %}

            <button type="button"
                    class="btn btn-outline-primary act-passkey-login__button"
                    data-act-passkey-login-button>
                {{ 'act-passkey.login.button'|trans }}
            </button>

            {# Must stay inside this container: the JS plugin looks it up from
               its root element. #}
            <div class="act-passkey-login__error alert alert-danger w-100 mt-2"
                 data-act-passkey-login-error
                 hidden></div>
        </div>
    </div>
{% endblock %}
