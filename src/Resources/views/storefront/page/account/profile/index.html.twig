{% sw_extends '@Storefront/storefront/page/account/profile/index.html.twig' %}

{% block page_account_profile_mail_and_password %}
    {% block page_account_profile_passkeys %}
        <div class="card account-passkeys mb-4"
             data-act-passkey-manage
             data-challenge-url="{{ path('frontend.account.passkey.register.challenge') }}"
             data-register-url="{{ path('frontend.account.passkey.register') }}"
             data-error-text="{{ 'act-passkey.manage.error'|trans }}">
            <div class="card-body">
                <div class="card-title">{{ 'act-passkey.manage.title'|trans|sw_sanitize }}</div>

                {% set passkeyCredentials = page.extensions.actPasskeyCredentials.credentials ?? [] %}
                {% set orphanedIds = page.extensions.actPasskeyCredentials.orphanedIds ?? [] %}

                {% if passkeyCredentials is empty %}
                    <p class="act-passkey-manage__empty">{{ 'act-passkey.manage.empty'|trans|sw_sanitize }}</p>
                {% else %}
                    {# The forms render open and the toggles hidden, so the list
                       stays usable without JS; the plugin flips that around. #}
                    <ul class="list-unstyled mb-3 act-passkey-manage__list">
                        {% for credential in passkeyCredentials %}
                            <li class="act-passkey-manage__item mb-3" data-act-passkey-item>
                                {# Same grid as the credentials section above, so the
                                   actions line up with its change links. #}
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6">
                                        <div class="act-passkey-manage__name">{{ credential.name }}</div>
                                        <div class="act-passkey-manage__meta text-muted small">
                                            {% if credential.lastUsedAt %}
                                                {{ 'act-passkey.manage.lastUsed'|trans({'%date%': credential.lastUsedAt|format_date('medium')}) }}
                                            {% else %}
                                                {{ 'act-passkey.manage.neverUsed'|trans }}
                                            {% endif %}
                                        </div>
                                        {% if credential.id in orphanedIds %}
                                            <div class="act-passkey-manage__orphaned text-muted small">
                                                {{ 'act-passkey.manage.orphaned'|trans|sw_sanitize }}
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="col-12 col-sm-6 col-md-3 mt-2 mt-md-0"
                                         data-act-passkey-item-actions
                                         hidden>
                                        {# The name is only in the aria-label: the visible text has to
                                           stay short, but "Rename" alone repeats per list item. #}
                                        <button type="button"
                                                class="btn btn-link account-profile-change p-0 align-baseline"
                                                aria-expanded="false"
                                                aria-controls="act-passkey-rename-{{ credential.id }}"
                                                aria-label="{{ 'act-passkey.manage.renameNamed'|trans({'%name%': credential.name}) }}"
                                                data-act-passkey-rename-toggle>
                                            {{ 'act-passkey.manage.rename'|trans }}
                                        </button>
                                    </div>

                                    <div class="col-12 col-sm-6 col-md-3 mt-2 mt-md-0"
                                         data-act-passkey-item-actions
                                         hidden>
                                        <button type="button"
                                                class="btn btn-link link-danger account-profile-change p-0 align-baseline"
                                                aria-expanded="false"
                                                aria-controls="act-passkey-delete-{{ credential.id }}"
                                                aria-label="{{ 'act-passkey.manage.deleteNamed'|trans({'%name%': credential.name}) }}"
                                                data-act-passkey-delete-toggle>
                                            {{ 'act-passkey.manage.delete'|trans }}
                                        </button>
                                    </div>
                                </div>

                                <form action="{{ path('frontend.account.passkey.rename', {id: credential.id}) }}"
                                      method="post"
                                      class="act-passkey-manage__rename-form mt-2"
                                      id="act-passkey-rename-{{ credential.id }}"
                                      data-act-passkey-rename-form>
                                    <div class="row row-cols-lg-auto g-2 align-items-center">
                                        <div class="col-12">
                                            <label class="visually-hidden" for="act-passkey-name-{{ credential.id }}">
                                                {{ 'act-passkey.manage.nameLabel'|trans }}
                                            </label>
                                            <input type="text"
                                                   id="act-passkey-name-{{ credential.id }}"
                                                   name="name"
                                                   value="{{ credential.name }}"
                                                   maxlength="128"
                                                   class="form-control form-control-sm act-passkey-manage__name-input"
                                                   required>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                {{ 'act-passkey.manage.save'|trans }}
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <button type="button"
                                                    class="btn btn-sm btn-link"
                                                    data-act-passkey-rename-cancel
                                                    hidden>
                                                {{ 'act-passkey.manage.cancel'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <form action="{{ path('frontend.account.passkey.delete', {id: credential.id}) }}"
                                      method="post"
                                      class="act-passkey-manage__delete-form mt-2"
                                      id="act-passkey-delete-{{ credential.id }}"
                                      data-act-passkey-delete-form>
                                    <p class="text-muted small mb-2"
                                       id="act-passkey-delete-hint-{{ credential.id }}">{{ 'act-passkey.manage.passwordHint'|trans|sw_sanitize }}</p>
                                    <div class="row row-cols-lg-auto g-2 align-items-center">
                                        <div class="col-12">
                                            {# The placeholder alone is no accessible name and disappears on typing. #}
                                            <label class="visually-hidden" for="act-passkey-delete-password-{{ credential.id }}">
                                                {{ 'act-passkey.manage.passwordLabel'|trans }}
                                            </label>
                                            <input type="password"
                                                   id="act-passkey-delete-password-{{ credential.id }}"
                                                   name="password"
                                                   class="form-control form-control-sm"
                                                   placeholder="{{ 'act-passkey.manage.passwordLabel'|trans }}"
                                                   autocomplete="current-password"
                                                   aria-describedby="act-passkey-delete-hint-{{ credential.id }}"
                                                   required>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                {{ 'act-passkey.manage.delete'|trans }}
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <button type="button"
                                                    class="btn btn-sm btn-link"
                                                    data-act-passkey-delete-cancel
                                                    hidden>
                                                {{ 'act-passkey.manage.cancel'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if page.extensions.actPasskeySupported.supported ?? false %}
                    {# The password step-up is a security requirement, not a
                       convenience: a passkey is a login factor, so a hijacked
                       session must not be able to add one. #}
                    <div class="act-passkey-manage__register" data-act-passkey-manage-register hidden>
                        {% block act_passkey_manage_register_start %}
                            <button type="button"
                                    class="btn btn-primary act-passkey-manage__start"
                                    aria-expanded="false"
                                    aria-controls="actPasskeyRegisterForm"
                                    data-act-passkey-manage-start>
                                {{ 'act-passkey.manage.register'|trans }}
                            </button>
                        {% endblock %}

                        {% block act_passkey_manage_register_form %}
                            <form class="act-passkey-manage__register-form"
                                  id="actPasskeyRegisterForm"
                                  data-act-passkey-manage-form
                                  hidden>
                                <p class="act-passkey-manage__password-hint text-muted small mb-2"
                                   id="actPasskeyPasswordHint">
                                    {{ 'act-passkey.manage.passwordHint'|trans|sw_sanitize }}
                                </p>

                                {# Bootstrap 5 dropped form-inline; this is its replacement. #}
                                <div class="row row-cols-lg-auto g-2 align-items-center">
                                    <div class="col-12">
                                        <label class="visually-hidden" for="actPasskeyPassword">
                                            {{ 'act-passkey.manage.passwordLabel'|trans }}
                                        </label>
                                        <input type="password"
                                               id="actPasskeyPassword"
                                               name="password"
                                               class="form-control form-control-sm"
                                               placeholder="{{ 'act-passkey.manage.passwordLabel'|trans }}"
                                               autocomplete="current-password"
                                               aria-describedby="actPasskeyPasswordHint"
                                               required
                                               data-act-passkey-manage-password>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            {{ 'act-passkey.manage.confirm'|trans }}
                                        </button>
                                    </div>
                                    <div class="col-12">
                                        <button type="button"
                                                class="btn btn-sm btn-link"
                                                data-act-passkey-manage-cancel>
                                            {{ 'act-passkey.manage.cancel'|trans }}
                                        </button>
                                    </div>
                                </div>
                            </form>
                        {% endblock %}

                        {# role="alert" only announces once the region is rendered, so the
                           JS reveals it before writing the message into it. #}
                        <div class="act-passkey-manage__error alert alert-danger mt-2"
                             role="alert"
                             data-act-passkey-manage-error
                             hidden></div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endblock %}

    {{ parent() }}
{% endblock %}
