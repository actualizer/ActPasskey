{% sw_extends '@Administration/administration/index.html.twig' %}

{% block administration_login_scripts %}
    {{ parent() }}

    {# The URL must match /api/_info/config character for character: after login
       the boot injects a second tag for the same file, and the browser skips
       re-evaluating the module only on an identical URL. `asset(src)` would add a
       cache-busting query and every override would run twice. #}
    {% for src in act_passkey_admin_scripts() %}
        <script type="module" src="{{ asset('', 'asset') ~ src }}" nonce="{{ cspNonce }}"></script>
    {% endfor %}
{% endblock %}
